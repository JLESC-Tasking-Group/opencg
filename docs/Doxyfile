# Doxyfile for OpenCG documentation

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "OpenCG"
PROJECT_BRIEF          = "Open Command Graphs - Vendor-agnostic DAG command graph library"
PROJECT_NUMBER         =
OUTPUT_DIRECTORY       = build
CREATE_SUBDIRS         = NO

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = ../README.md \
                         ../include/opencg \
                         ../src \
                         concepts/commands.md \
                         concepts/command-graphs.md \
                         concepts/optimization-passes.md \
                         concepts/integration.md
FILE_PATTERNS          = *.hpp *.h *.cc *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = ../README.md
EXCLUDE_PATTERNS       = */build/*

#---------------------------------------------------------------------------
# Build options
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO
BUILTIN_STL_SUPPORT    = YES

#---------------------------------------------------------------------------
# Preprocessing
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             = OCG_NAMESPACE_BEGIN="namespace ocg {" \
                         OCG_NAMESPACE_END="}" \
                         OCG_NAMESPACE=ocg

#---------------------------------------------------------------------------
# Output format
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

#---------------------------------------------------------------------------
# HTML options
#---------------------------------------------------------------------------
HTML_OUTPUT            = html
HTML_EXTRA_STYLESHEET  = doxygen-awesome-css/doxygen-awesome.css
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES
HTML_COLORSTYLE_HUE    = 209
HTML_COLORSTYLE_SAT    = 255
HTML_COLORSTYLE_GAMMA  = 113

#---------------------------------------------------------------------------
# Markdown
#---------------------------------------------------------------------------
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

#---------------------------------------------------------------------------
# Diagrams
#---------------------------------------------------------------------------
HAVE_DOT               = NO
CLASS_DIAGRAMS         = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
